{
  "name": "@thefoolspath/gethen-angular",
  "version": "0.0.0-alpha.2",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node ../../scripts/copy-package-assets.mjs src dist html css",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts --passWithNoTests"
  },
  "peerDependencies": {
    "@angular/core": ">=22.0.0"
  },
  "dependencies": {
    "@thefoolspath/gethen-core": "workspace:*",
    "@thefoolspath/gethen-protocol": "workspace:*"
  }
}
